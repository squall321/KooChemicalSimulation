Bootstrap: docker
From: nvidia/cuda:12.0.0-devel-ubuntu22.04

%labels
    Author KooLab Development Team
    Version 6.0.0-alpha5
    Description KooLab Chemical Simulation Library (GPU version with CUDA 12.0)

%help
    KooLab Chemical Simulation Library v6.0.0-alpha5 (GPU version)

    This container includes KooLab with CUDA 12.0 support for GPU acceleration.

    Requirements:
        - NVIDIA GPU with compute capability >= 6.0 (Pascal or newer)
        - NVIDIA driver >= 525.60.13
        - apptainer run with --nv flag for GPU access

    Usage:
        # Run with GPU support
        apptainer run --nv koolab_gpu.sif /opt/koolab/bin/gpu_performance_comparison

        # Interactive shell with GPU
        apptainer shell --nv koolab_gpu.sif

        # Check GPU availability
        apptainer exec --nv koolab_gpu.sif nvidia-smi

        # Python with GPU
        apptainer exec --nv koolab_gpu.sif python3 -c "import _core as koo; print('GPU enabled')"

        # Jupyter with GPU
        apptainer exec --nv koolab_gpu.sif jupyter notebook --ip=0.0.0.0 --port=8888

    Performance:
        50-100x speedup over CPU for large problems

    For more information:
        https://github.com/squall321/KooChemicalSimulation

%post
    # Update and install basic tools
    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        ninja-build \
        git \
        wget \
        curl \
        vim \
        python3 \
        python3-pip \
        python3-dev \
        pkg-config \
        && rm -rf /var/lib/apt/lists/*

    # Install C++ dependencies
    apt-get update && apt-get install -y \
        libeigen3-dev \
        libfmt-dev \
        libspdlog-dev \
        nlohmann-json3-dev \
        libyaml-cpp-dev \
        libgtest-dev \
        libhdf5-dev \
        libvtk9-dev \
        && rm -rf /var/lib/apt/lists/*

    # Install Python dependencies
    pip3 install --no-cache-dir \
        numpy \
        matplotlib \
        scipy \
        jupyter \
        ipywidgets \
        pybind11 \
        cupy-cuda12x

    # Clone KooLab repository
    cd /opt
    git clone https://github.com/squall321/KooChemicalSimulation.git koolab-src
    cd koolab-src

    # Checkout specific version
    git checkout claude/project-status-review-011CUsQDsp6Q7ghbkTEHsovq

    # Build KooLab (GPU version)
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/koolab \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_PYTHON_BINDINGS=ON \
        -DBUILD_TESTS=ON \
        -DBUILD_EXAMPLES=ON \
        -DBUILD_BENCHMARKS=ON \
        -DENABLE_OPENMP=ON \
        -DENABLE_MPI=OFF \
        -DBUILD_GPU=ON \
        -DCMAKE_CUDA_ARCHITECTURES="60;70;75;80;86;89;90"

    cmake --build build -j$(nproc)

    # Run CPU tests (GPU tests require actual GPU)
    cd build && ctest --output-on-failure -E ".*GPU.*" || true

    # Install
    cmake --install build

    # Install Python package
    cd /opt/koolab-src/python
    pip3 install --no-cache-dir .

    # Create symbolic links
    ln -s /opt/koolab/bin/* /usr/local/bin/ || true

    # Cleanup
    cd /
    rm -rf /opt/koolab-src/build
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    # Set paths
    export PATH=/opt/koolab/bin:$PATH
    export LD_LIBRARY_PATH=/opt/koolab/lib:$LD_LIBRARY_PATH
    export PYTHONPATH=/opt/koolab/lib/python3.10/site-packages:$PYTHONPATH

    # CUDA paths
    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

    # OpenMP settings
    export OMP_NUM_THREADS=4

    # GPU settings
    export CUDA_VISIBLE_DEVICES=0

    # Locale
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    #!/bin/bash
    echo "KooLab Chemical Simulation Library v6.0.0-alpha5 (GPU)"
    echo "========================================================"
    echo ""

    # Check GPU availability
    if command -v nvidia-smi &> /dev/null; then
        echo "GPU Status:"
        nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
        echo ""
    else
        echo "⚠ WARNING: GPU not detected. Run with --nv flag:"
        echo "  apptainer run --nv koolab_gpu.sif"
        echo ""
    fi

    if [ $# -eq 0 ]; then
        echo "Available executables:"
        ls -1 /opt/koolab/bin/
        echo ""
        echo "Usage: apptainer run --nv koolab_gpu.sif <executable> [args...]"
        echo ""
        echo "Examples:"
        echo "  apptainer run --nv koolab_gpu.sif /opt/koolab/bin/gpu_performance_comparison"
        echo "  apptainer exec --nv koolab_gpu.sif nvidia-smi"
        echo "  apptainer exec --nv koolab_gpu.sif python3 -c 'import cupy; print(cupy.cuda.runtime.getDeviceCount())'"
    else
        exec "$@"
    fi

%test
    # Verify installation
    echo "Testing KooLab GPU installation..."

    # Check binaries
    test -f /opt/koolab/bin/full_simulation_example || exit 1
    echo "✓ Binaries found"

    # Check libraries
    test -f /opt/koolab/lib/libkoolab_core.so || exit 1
    echo "✓ Libraries found"

    # Check Python module
    python3 -c "import _core as koo" || exit 1
    echo "✓ Python module working"

    # Check CUDA
    test -f /usr/local/cuda/bin/nvcc || exit 1
    echo "✓ CUDA toolkit found"

    # Check CuPy
    python3 -c "import cupy" || exit 1
    echo "✓ CuPy installed"

    echo ""
    echo "All tests passed! KooLab GPU is ready to use."
    echo "Note: GPU runtime tests require running with --nv flag and actual GPU hardware."
