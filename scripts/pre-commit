#!/bin/bash
# Pre-commit hook for KooChemicalSimulation
# This hook runs clang-format check on staged files

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Check if clang-format is available
if ! command -v clang-format &> /dev/null; then
    echo -e "${YELLOW}Warning: clang-format not found, skipping format check${NC}"
    exit 0
fi

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp)$')

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No C++ files to check${NC}"
    exit 0
fi

echo -e "${YELLOW}Checking code formatting...${NC}"

# Check formatting
FORMAT_ISSUES=0
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        # Check if file needs formatting
        clang-format --dry-run --Werror "$FILE" 2>&1 | grep -q "warning:"
        if [ $? -eq 0 ]; then
            echo -e "${RED}✗ $FILE needs formatting${NC}"
            FORMAT_ISSUES=1
        else
            echo -e "${GREEN}✓ $FILE${NC}"
        fi
    fi
done

if [ $FORMAT_ISSUES -eq 1 ]; then
    echo -e "${RED}"
    echo "================================================"
    echo "  Code formatting issues found!"
    echo "================================================"
    echo -e "${NC}"
    echo "Please run:"
    echo "  cmake --build build --target format"
    echo ""
    echo "Or to format specific files:"
    echo "  clang-format -i <file>"
    echo ""
    echo "To skip this check (NOT recommended):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}"
echo "================================================"
echo "  All checks passed! ✓"
echo "================================================"
echo -e "${NC}"

exit 0
